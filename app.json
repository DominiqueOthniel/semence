{
  "expo": {
    "name": "Semence",
    "slug": "semence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/marque-semence-or.png",
    "userInterfaceStyle": "light",
    "scheme": "semence",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/marque-semence-or.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cm.semence.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "cm.semence.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Semence utilise ta photo pour ton profil.",
          "cameraPermission": "Semence utilise la caméra pour ta photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
